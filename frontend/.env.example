# true (default): canned answers from src/api/mock.ts
# false: call the FastAPI /search endpoint
VITE_USE_MOCK=true

# Base URL of the FastAPI server. Default is http://localhost:8000.
# Set to an empty string to use same-origin paths (Vite will proxy /search and /health).
VITE_API_BASE_URL=http://localhost:8000
