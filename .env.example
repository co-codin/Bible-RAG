# DeepEval judge (LLM-as-a-judge)
ANTHROPIC_API_KEY=
EVAL_JUDGE_MODEL=claude-haiku-5-5

# Local Milvus Lite db (directory). Override to http://localhost:19530 for docker.
# MILVUS_URI=./.milvus/bible_rag.db

# CORS origins for the Vite dev server (comma-separated)
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Generation (default provider: OpenAI). Leave blank until you are ready to call the API.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=

# To use DeepSeek instead, with the same client interface:
# LLM_PROVIDER=deepseek
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Input guard semantic check (bge-m3 dense similarity, no LLM). Default is on.
# GUARD_SEMANTIC=1
# GUARD_TOPIC_ALLOW_MARGIN=0.19
# GUARD_TOPIC_REFUSE_MARGIN=-0.06

